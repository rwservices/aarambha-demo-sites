{
	"name": "rwservices/aarambha-demo-sites",
	"type": "wordpress-plugin",
	"description": "Aarambha Demo Sites - a WordPress demo importer plugin for importing Aarambha Themes demo content, widgets and settings with one click.",
	"keywords": [
		"wordpress",
		"plugin",
		"demo-importer"
	],
	"license": "GPL-2.0-or-later",
	"homepage": "https://aarambhathemes.com/",
	"authors": [
		{
			"name": "Rabindra Tharu",
			"email": "rabindra.tharu.np@gmail.com",
			"homepage": "https://github.com/rabindratharu/",
			"role": "Developer"
		}
	],
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true,
			"phpstan/extension-installer": true,
			"composer/installers": true
		},
		"platform": {
			"php": "8.0"
		},
		"sort-packages": true,
		"preferred-install": "dist"
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"extra": {
		"installer-paths": {
			"vendor/{$vendor}/{$name}/": [
				"wpackagist-plugin/plugin-check"
			]
		}
	},
    "autoload-dev": {
		"psr-4": {
			"Aarambha_Demo_Sites\\Tests\\": "tests/"
		}
	},
	"repositories": [
		{
			"type": "composer",
			"url": "https://wpackagist.org",
			"only": [
				"wpackagist-plugin/*",
				"wpackagist-theme/*"
			]
		}
	],
	"require": {
		"php": "^8"
	},
	"require-dev": {
		"automattic/vipwpcs": "^3.0",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpcompatibility/php-compatibility": "^10.0.0-alpha",
		"phpcompatibility/phpcompatibility-wp": "^3.0.0-alpha",
		"phpstan/extension-installer": "^1.3",
		"phpstan/phpstan-deprecation-rules": "^2.0.3",
		"phpstan/phpstan-phpunit": "^2.0.3",
		"phpstan/phpstan": "^2.1.22",
		"phpunit/phpunit": "^8.5|^9.6",
		"slevomat/coding-standard": "^8.0",
		"squizlabs/php_codesniffer": "^3.9",
		"szepeviktor/phpstan-wordpress": "^2.0.2",
		"wp-coding-standards/wpcs": "^3.1",
		"wp-phpunit/wp-phpunit": "^6.5",
		"wpackagist-plugin/plugin-check": "~1.6.0",
		"yoast/phpunit-polyfills": "^4.0"
	},
	"scripts": {
		"format": "phpcbf",
		"lint": "phpcs",
		"phpstan": "phpstan analyse --memory-limit=1G",
		"test": "vendor/bin/phpunit -c phpunit.xml.dist",
		"test-multisite": "WP_MULTISITE=1 phpunit --exclude-group=ms-excluded"
	},
    "support": {
		"issues": "https://github.com/rwservices/aarambha-demo-sites/issues",
		"source": "https://github.com/rwservices/aarambha-demo-sites",
		"docs": "https://github.com/rwservices/aarambha-demo-sites#readme"
	}
}